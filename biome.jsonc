{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!**/node_modules",
      "!dist",
      "!**/dist",
      "!**/.nuxt",
      "!**/.output",
      "!**/.wrangler",
      "!**/worker-configuration.d.ts",
      "!coverage",
      "!**/coverage",
      "!docs/spikes"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["*.ts", "**/*.ts"],
                "message": "Use TypeScript bundler resolution; do not include .ts in import specifiers."
              }
            ]
          }
        }
      }
    }
  }
}
