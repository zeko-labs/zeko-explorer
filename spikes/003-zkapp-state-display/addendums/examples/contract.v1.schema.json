{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeko.io/schema/v1/contract.json",
  "title": "ZekoContractSubmission",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "meta", "state"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "type": "integer", "const": 1 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "networks", "name"],
      "properties": {
        "address": { "type": "string", "pattern": "^B62q[1-9A-HJ-NP-Za-km-z]{51}$" },
        "networks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["zeko-m-devnet", "zeko-m-mainnet"] }
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "maxLength": 280 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "commit"],
          "properties": {
            "repo": { "type": "string", "format": "uri" },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "vkeyHash": { "type": "string", "pattern": "^[0-9]+$" }
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Struct" }
    },
    "state": { "$ref": "#/$defs/Layout" },
    "events": { "$ref": "#/$defs/Variants" },
    "actions": { "$ref": "#/$defs/Variants" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "signature"],
      "properties": {
        "address": { "type": "string", "pattern": "^B62q[1-9A-HJ-NP-Za-km-z]{51}$" },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["r", "s"],
          "properties": {
            "r": { "type": "string", "pattern": "^[0-9]+$" },
            "s": { "type": "string", "pattern": "^[0-9]+$" }
          }
        }
      }
    }
  },
  "$defs": {
    "Slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "name", "type"],
      "properties": {
        "at": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "type": { "type": "string" }
      }
    },
    "Layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots"],
      "properties": {
        "slots": { "type": "array", "items": { "$ref": "#/$defs/Slot" } }
      }
    },
    "Struct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        }
      }
    },
    "Variants": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": { "type": "array", "items": { "$ref": "#/$defs/Slot" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["discriminator", "variants"],
          "properties": {
            "discriminator": {
              "type": "object",
              "additionalProperties": false,
              "required": ["at"],
              "properties": { "at": { "type": "integer", "minimum": 0 } }
            },
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["when", "kind", "fields"],
                "properties": {
                  "when": { "type": "string" },
                  "kind": { "type": "string" },
                  "fields": { "type": "array", "items": { "$ref": "#/$defs/Slot" } }
                }
              }
            }
          }
        }
      ]
    }
  }
}
