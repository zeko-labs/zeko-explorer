{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rootDir": "src",
    "outDir": "../../.moon/cache/types/services/zeko-indexer",
    "tsBuildInfoFile": "../../.moon/cache/types/services/zeko-indexer/tsconfig.tsbuildinfo",
    "paths": {
      "@zeko/database": ["../database/src/index.ts"],
      "@zeko/database/*": ["../database/src/*"],
      "@zeko/nats": ["../nats/src/index.ts"],
      "@zeko/nats/*": ["../nats/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../database"
    },
    {
      "path": "../nats"
    }
  ]
}
