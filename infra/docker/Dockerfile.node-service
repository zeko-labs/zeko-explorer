FROM debian:trixie-slim AS base
WORKDIR /workspace
ENV PROTO_HOME=/opt/proto
ENV PATH="${PROTO_HOME}/shims:${PROTO_HOME}/bin:${PATH}"
RUN apt-get update \
  && apt-get install --yes --no-install-recommends bash ca-certificates curl git libatomic1 tar xz-utils \
  && rm -rf /var/lib/apt/lists/*
COPY .prototools ./
RUN curl -fsSL https://moonrepo.dev/install/proto.sh | bash -s -- --yes \
  && proto install node \
  && proto install pnpm \
  && proto install moon

FROM base AS deps
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY apps ./apps
COPY services ./services
COPY packages ./packages
COPY .moon ./.moon
RUN moon sync
RUN pnpm install --prod --frozen-lockfile=false

FROM deps AS runner
ARG MOON_TARGET
ENV NODE_ENV=production
ENV PORT=4100
ENV MOON_TARGET=${MOON_TARGET}
CMD ["sh", "-ceu", "case \"${MOON_TARGET}\" in explorer-api) export PORT=4101 ;; bridge-api) export PORT=4102 ;; esac; moon run --no-actions \"${MOON_TARGET}:dev\""]
