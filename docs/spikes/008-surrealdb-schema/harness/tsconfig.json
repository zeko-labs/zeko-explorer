{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "benchmarks/**/*.ts",
    "features/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts"
  ]
}
